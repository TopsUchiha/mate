# PostgreSQL connection string (Render: use the "Internal Database URL" for the web service)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Long random string used to sign admin session tokens.
# Generate with: openssl rand -base64 48
AUTH_SECRET=

# Mapbox public token (starts with pk.). Used for the tracking map and geocoding locations.
MAPBOX_PUBLIC_TOKEN=
NEXT_PUBLIC_MAPBOX_TOKEN=

# Public site URL (used for sitemap, robots.txt and Open Graph tags)
NEXT_PUBLIC_SITE_URL="https://your-app.onrender.com"

# Initial admin account used ONLY by `npm run db:seed`. Remove from the environment after seeding.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Set to "true" to also seed fictional demo shipments and messages.
SEED_DEMO_DATA=false
